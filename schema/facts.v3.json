{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shermanhuman/cartographer/schema/facts.v3.json",
  "title": "cartographer facts v3",
  "type": "object",
  "required": [
    "facts_version",
    "producer"
  ],
  "additionalProperties": false,
  "properties": {
    "facts_version": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "producer": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "call_precision": {
          "$ref": "#/$defs/precision"
        }
      }
    },
    "repo": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "language": {
            "type": "string"
          }
        }
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "arity",
          "min_arity",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "arity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "min_arity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "kind": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "clauses": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "fingerprint": {
            "type": "string"
          },
          "test": {
            "type": "boolean"
          }
        }
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "required": [
              "name",
              "arity"
            ],
            "additionalProperties": false,
            "properties": {
              "module": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "arity": {
                "type": "integer"
              }
            }
          },
          "kind": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "precision": {
            "$ref": "#/$defs/precision"
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "nullable"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "nullable": {
                  "type": "boolean"
                },
                "default": {
                  "type": "string"
                }
              }
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "definition": {
                  "type": "string"
                }
              }
            }
          },
          "indexes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "foreign_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_table",
          "from_columns",
          "to_table",
          "to_columns"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "from_table": {
            "type": "string"
          },
          "to_table": {
            "type": "string"
          },
          "from_columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "to_columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "table_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "table",
          "file",
          "line"
        ],
        "additionalProperties": false,
        "properties": {
          "table": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "function": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "handler": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "precision": {
            "$ref": "#/$defs/precision"
          }
        }
      }
    },
    "http_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "path",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "base": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "origin": {
            "enum": [
              "same"
            ]
          }
        }
      }
    },
    "config_urls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "value",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "name",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "deployment",
              "service"
            ]
          },
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "selector": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          }
        }
      }
    },
    "stats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "language"
        ],
        "additionalProperties": false,
        "properties": {
          "language": {
            "type": "string"
          },
          "call_sites": {
            "type": "integer",
            "minimum": 0
          },
          "in_repo": {
            "type": "integer",
            "minimum": 0
          },
          "dispatch": {
            "type": "integer",
            "minimum": 0
          },
          "external": {
            "type": "integer",
            "minimum": 0
          },
          "unresolved": {
            "type": "integer",
            "minimum": 0
          },
          "refs": {
            "type": "integer",
            "minimum": 0
          },
          "not_extracted": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "via",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "dynamic": {
            "type": "boolean"
          },
          "via": {
            "type": "string"
          },
          "target": {
            "enum": [
              "",
              "myself",
              "dynamic"
            ]
          },
          "hooks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "precision": {
            "$ref": "#/$defs/precision"
          }
        }
      }
    },
    "event_handlers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "function",
          "source",
          "line"
        ],
        "additionalProperties": false,
        "properties": {
          "function": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "source": {
            "enum": [
              "head",
              "guard",
              "attribute",
              "delegate"
            ]
          },
          "delegate": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "hook_mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hook",
          "from",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "hook": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "receivers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "facts_version": {
        "const": 1
      }
    },
    "required": [
      "facts_version"
    ]
  },
  "then": {
    "properties": {
      "routes": false,
      "http_refs": false,
      "config_urls": false,
      "services": false,
      "stats": false,
      "functions": {
        "items": {
          "not": {
            "required": [
              "test"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "facts_version": {
            "enum": [
              1,
              2
            ]
          }
        },
        "required": [
          "facts_version"
        ]
      },
      "then": {
        "properties": {
          "events": false,
          "event_handlers": false,
          "hook_mounts": false,
          "http_refs": {
            "items": {
              "not": {
                "required": [
                  "origin"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "precision": {
      "enum": [
        "precise",
        "heuristic",
        "candidate"
      ]
    }
  }
}
